@page "/financial-dashboard"
@attribute [Authorize(Roles = "FinancialDepartment")]
@implements IDisposable
@using Application.Queries.Shifts
@using Entities
@inject GetShiftsPastEndDateQueryHandler GetShiftsPastEndDateHandler
@rendermode InteractiveServer

<PageTitle>Financieel Dashboard - LOTUS Planning App</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-0 text-primary">
                <i class="fas fa-chart-line me-2"></i>Financieel dashboard
            </h1>
            <p class="text-muted">Deelopdrachten met een verstreken einddatum</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laden...</span>
            </div>
        </div>
    }
    else if (hasError)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="alert alert-danger d-inline-flex align-items-center mb-0" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            </div>
        </div>
    }
    else if (shiftsPastEndDate.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Deelopdracht</th>
                                <th>Opdracht</th>
                                <th>Start</th>
                                <th>Einde</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shift in shiftsPastEndDate)
                            {
                                <tr>
                                    <td>@shift.Name</td>
                                    <td>@shift.Event.Name</td>
                                    <td>@shift.StartTime.ToString("g")</td>
                                    <td>@shift.EndTime.ToString("g")</td>
                                    <td>
                                        <span class="badge bg-@GetShiftStatusColor(shift.Status)">
                                            @shift.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <p class="text-muted mb-0">Er zijn momenteel geen deelopdrachten met een verstreken einddatum.</p>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool hasError;
    private List<Shift> shiftsPastEndDate = new();
    private string errorMessage = "Er is een fout opgetreden bij het laden van het financieel dashboard.";
    private readonly CancellationTokenSource cancellationTokenSource = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var query = new GetShiftsPastEndDateQuery();
            shiftsPastEndDate = await GetShiftsPastEndDateHandler.Handle(query, cancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
            hasError = false;
            shiftsPastEndDate = new();
        }
        catch
        {
            hasError = true;
            shiftsPastEndDate = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetShiftStatusColor(ShiftStatus status)
    {
        return status switch
        {
            ShiftStatus.Open => "primary",
            ShiftStatus.Full => "info",
            ShiftStatus.InProgress => "success",
            ShiftStatus.Completed => "secondary",
            ShiftStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }
}
