IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.BaseRevisionTextPatchEP
<+>@page \"/shifts/edit/{ShiftId:int}\"\n@attribute [Authorize(Roles = \"Admin\")]\n@using Application\n@using Application.DataAdapters\n@using Application.Queries.Shifts\n@using Application.Queries.Staff\n@using Application.Queries.StaffAssignments\n@using Application.Commands.Shifts\n@using Application.Commands.StaffAssignments\n@using Entities\n@inject GetShiftByIdQueryHandler GetShiftByIdHandler\n@inject GetActiveStaffQueryHandler GetActiveStaffHandler\n@inject IsStaffAvailableQueryHandler IsStaffAvailableHandler\n@inject CreateStaffAssignmentCommandHandler CreateAssignmentHandler\n@inject DeleteStaffAssignmentCommandHandler DeleteAssignmentHandler\n@inject UpdateShiftCommandHandler UpdateShiftHandler\n@inject NavigationManager Navigation\n@rendermode InteractiveServer\n\n<PageTitle>Deelopdracht bewerken - LOTUS Planning App</PageTitle>\n\n@if (isLoading)\n{\n    <div class=\"d-flex justify-content-center py-5\">\n        <div class=\"spinner-border text-primary\" role=\"status\">\n            <span class=\"visually-hidden\">Bezig met laden...</span>\n        </div>\n    </div>\n}\nelse if (shift == null)\n{\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div class=\"col\">\n                <div class=\"alert alert-warning\">\n                    <i class=\"fas fa-exclamation-triangle me-2\"></i>\n                    <strong>Deelopdracht niet gevonden</strong>\n                    <p class=\"mb-0\">De gevraagde deelopdracht is niet gevonden.</p>\n                </div>\n                <a href=\"/events\" class=\"btn btn-primary\">\n                    <i class=\"fas fa-arrow-left me-2\"></i>Terug naar opdrachten\n                </a>\n            </div>\n        </div>\n    </div>\n}\nelse\n{\n    <div class=\"container-fluid\">\n        <!-- Header -->\n        <div class=\"row mb-4\">\n            <div class=\"col\">\n                <nav aria-label=\"breadcrumb\">\n                    <ol class=\"breadcrumb\">\n                        <li class=\"breadcrumb-item\">\n                            <a href=\"/events\" class=\"text-decoration-none\">Opdrachten</a>\n                        </li>\n                        <li class=\"breadcrumb-item\">\n                            <a href=\"/events/details/@shift.EventId\" class=\"text-decoration-none\">@shift.Event.Name</a>\n                        </li>\n                        <li class=\"breadcrumb-item active\" aria-current=\"page\">Deelopdracht bewerken</li>\n                    </ol>\n                </nav>\n                <div class=\"d-flex justify-content-between align-items-center\">\n                    <div>\n                        <h1 class=\"h3 mb-0 text-primary\">\n                            <i class=\"fas fa-edit me-2\"></i>Deelopdracht bewerken\n                        </h1>\n                        <p class=\"text-muted mb-0\">@shift.Name</p>\n                    </div>\n                    <div class=\"btn-group\" role=\"group\">\n                        <button class=\"btn btn-outline-secondary\" @onclick=\"Cancel\">\n                            <i class=\"fas fa-times me-2\"></i>Annuleren\n                        </button>\n                        <button class=\"btn btn-primary\" @onclick=\"SaveShift\" disabled=\"@isSaving\">\n                            @if (isSaving)\n                            {\n                                <span class=\"spinner-border spinner-border-sm me-2\"></span>\n                            }\n                            <i class=\"fas fa-save me-2\"></i>Wijzigingen opslaan\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\">\n            <!-- Shift Details -->\n            <div class=\"col-lg-6 mb-4\">\n                <div class=\"card border-0 shadow-sm\">\n                    <div class=\"card-header bg-primary text-white\">\n                        <h5 class=\"card-title mb-0\">\n                            <i class=\"fas fa-clock me-2\"></i>Opdrachtdetails\n                        </h5>\n                    </div>\n                    <div class=\"card-body\">\n                        <EditForm Model=\"editShift\" OnValidSubmit=\"SaveShift\">\n                            <DataAnnotationsValidator />\n                            \n                            <!-- Event Info (Read-only) -->\n                            <div class=\"mb-3\">\n                                <label class=\"form-label text-muted small\">OPDRACHT</label>\n                                <div class=\"p-3 bg-light rounded\">\n                                    <div class=\"fw-medium\">@shift.Event.Name</div>\n                                    <small class=\"text-muted\">\n                                        <i class=\"fas fa-map-marker-alt me-1\"></i>@shift.Event.Location<br>\n                                        <i class=\"fas fa-calendar me-1\"></i>@shift.Event.StartDate.ToString(\"g\") - @shift.Event.EndDate.ToString(\"g\")\n                                    </small>\n                                </div>\n                            </div>\n\n                            <!-- Shift Name -->\n                            <div class=\"mb-3\">\n                                <label class=\"form-label\">Deelopdrachtnaam *</label>\n                                <InputText @bind-Value=\"editShift.Name\" class=\"form-control\" placeholder=\"Voer een deelopdrachtnaam in\" />\n                                <ValidationMessage For=\"() => editShift.Name\" class=\"text-danger\" />\n                            </div>\n\n                            <!-- Times -->\n                            <div class=\"row\">\n                                <div class=\"col-md-6 mb-3\">\n                                    <label class=\"form-label\">Starttijd *</label>\n                                    <InputDate Type=\"InputDateType.DateTimeLocal\" @bind-Value=\"editShift.StartTime\" class=\"form-control\" />\n                                    <ValidationMessage For=\"() => editShift.StartTime\" class=\"text-danger\" />\n                                </div>\n                                <div class=\"col-md-6 mb-3\">\n                                    <label class=\"form-label\">Eindtijd *</label>\n                                    <InputDate Type=\"InputDateType.DateTimeLocal\" @bind-Value=\"editShift.EndTime\" class=\"form-control\" />\n                                    <ValidationMessage For=\"() => editShift.EndTime\" class=\"text-danger\" />\n                                </div>\n                            </div>\n\n                            <!-- Required Staff and Status -->\n                            <div class=\"row\">\n                                <div class=\"col-md-6 mb-3\">\n                                    <label class=\"form-label\">Benodigde LOTUS *</label>\n                                    <InputNumber @bind-Value=\"editShift.RequiredStaff\" class=\"form-control\" min=\"1\" max=\"50\" />\n                                    <ValidationMessage For=\"() => editShift.RequiredStaff\" class=\"text-danger\" />\n                                    <div class=\"form-text\">\n                                        <i class=\"fas fa-info-circle me-1\"></i>\n                                        Maximum aantal LOTUS dat aan deze deelopdracht kan worden gekoppeld\n                                    </div>\n                                </div>\n                                <div class=\"col-md-6 mb-3\">\n                                    <label class=\"form-label\">Status *</label>\n                                    <InputSelect @bind-Value=\"editShift.Status\" class=\"form-select\">\n                                        <option value=\"@ShiftStatus.Open\">Open</option>\n                                        <option value=\"@ShiftStatus.Full\">Vol</option>\n                                        <option value=\"@ShiftStatus.InProgress\">Bezig</option>\n                                        <option value=\"@ShiftStatus.Completed\">Afgerond</option>\n                                        <option value=\"@ShiftStatus.Cancelled\">Geannuleerd</option>\n                                    </InputSelect>\n                                    <ValidationMessage For=\"() => editShift.Status\" class=\"text-danger\" />\n                                </div>\n                            </div>\n\n                            <!-- Description -->\n                            <div class=\"mb-3\">\n                                <label class=\"form-label\">Beschrijving</label>\n                                <InputTextArea @bind-Value=\"editShift.Description\" class=\"form-control\" rows=\"3\" placeholder=\"Omschrijving van de deelopdracht (optioneel)\" />\n                                <ValidationMessage For=\"() => editShift.Description\" class=\"text-danger\" />\n                            </div>\n\n                            <!-- Validation Notes -->\n                            <div class=\"alert alert-warning\">\n                                <i class=\"fas fa-exclamation-triangle me-2\"></i>\n                                <strong>Let op:</strong> Zorg dat de diensttijden binnen de duur van de opdracht vallen \n                                (@shift.Event.StartDate.ToString(\"g\") - @shift.Event.EndDate.ToString(\"g\")).\n                                <br>\n                                <small class=\"text-muted mt-1\">\n                                    Huidig aantal toewijzingen: @currentAssignments.Count / @editShift.RequiredStaff\n                                </small>\n                            </div>\n                        </EditForm>\n                    </div>\n                </div>\n            </div>\n\n            <!-- LOTUS Toewijzing -->\n            <div class=\"col-lg-6\">\n                <div class=\"card border-0 shadow-sm\">\n                    <div class=\"card-header bg-success text-white d-flex justify-content-between align-items-center\">\n                        <h5 class=\"card-title mb-0\">\n                            <i class=\"fas fa-users me-2\"></i>LOTUS Toewijzing (@currentAssignments.Count / @editShift.RequiredStaff)\n                        </h5>\n                        @if (currentAssignments.Count < editShift.RequiredStaff)\n                        {\n                            <button class=\"btn btn-light btn-sm\" @onclick=\"OpenAddStaffDialog\">\n                                <i class=\"fas fa-plus me-1\"></i>LOTUS toevoegen\n                            </button>\n                        }\n                    </div>\n                    <div class=\"card-body\">\n                        @if (!currentAssignments.Any())\n                        {\n                            <div class=\"text-center py-4\">\n                                <i class=\"fas fa-users-slash fa-3x text-muted mb-3\"></i>\n                                <h6 class=\"text-muted\">Geen LOTUS toegewezen</h6>\n                                <p class=\"text-muted mb-3\">Deze deelopdracht heeft nog geen LOTUS toegewezen.</p>\n                                <button class=\"btn btn-success\" @onclick=\"OpenAddStaffDialog\">\n                                    <i class=\"fas fa-plus me-2\"></i>Eerste LOTUS toewijzen\n                                </button>\n                            </div>\n                        }\n                        else\n                        {\n                            <!-- Assigned Staff List -->\n                            <div class=\"list-group list-group-flush\">\n                                @foreach (var assignment in currentAssignments)\n                                {\n                                    <div class=\"list-group-item px-0 d-flex justify-content-between align-items-center\">\n                                        <div class=\"flex-grow-1\">\n                                            <div class=\"d-flex align-items-center\">\n                                                <div class=\"me-3\">\n                                                    <div class=\"bg-primary text-white rounded-circle d-flex align-items-center justify-content-center\" style=\"width: 40px; height: 40px;\">\n                                                        <span class=\"fw-bold\">@assignment.Staff.FirstName.Substring(0, 1)@assignment.Staff.LastName.Substring(0, 1)</span>\n                                                    </div>\n                                                </div>\n                                                <div class=\"flex-grow-1\">\n                                                    <h6 class=\"mb-1\">@assignment.Staff.FullName</h6>\n                                                    <div class=\"d-flex align-items-center\">\n                                                        <span class=\"badge bg-@GetRoleColor(assignment.Role) me-2\">\n                                                            <i class=\"fas fa-user-tag me-1\"></i>@assignment.Role\n                                                        </span>\n                                                        <span class=\"badge bg-@GetAssignmentStatusColor(assignment.Status)\">@assignment.Status</span>\n                                                    </div>\n                                                    @if (!string.IsNullOrEmpty(assignment.Staff.Phone))\n                                                    {\n                                                        <small class=\"text-muted\">\n                                                            <i class=\"fas fa-phone me-1\"></i>@assignment.Staff.Phone\n                                                        </small>\n                                                    }\n                                                </div>\n                                            </div>\n                                        </div>\n                                        <div class=\"btn-group btn-group-sm\" role=\"group\">\n                                                <button class=\"btn btn-outline-danger\" \n                                                    @onclick=\"() => ConfirmRemoveStaff(assignment)\"\n                                                    title=\"Verwijderen uit deelopdracht\">\n                                                <i class=\"fas fa-trash\"></i>\n                                            </button>\n                                        </div>\n                                    </div>\n                                }\n                            </div>\n\n                            @if (currentAssignments.Count < editShift.RequiredStaff)\n                            {\n                                <div class=\"mt-3\">\n                                    <button class=\"btn btn-outline-success w-100\" @onclick=\"OpenAddStaffDialog\">\n                                        <i class=\"fas fa-plus me-2\"></i>Nog een LOTUS toevoegen\n                                        <span class=\"badge bg-success ms-2\">@(editShift.RequiredStaff - currentAssignments.Count) plaatsen beschikbaar</span>\n                                    </button>\n                                </div>\n                            }\n                            else\n                            {\n                                <div class=\"alert alert-success mt-3 mb-0\">\n                                    <i class=\"fas fa-check-circle me-2\"></i>\n                                    <strong>Deelopdracht is volledig bezet!</strong> Alle benodigde posities zijn gevuld.\n                                </div>\n                            }\n                        }\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n}\n\n<!-- LOTUS toevoegen-modal -->\n@if (showAddStaffDialog)\n{\n    <div class=\"modal fade show d-block\" tabindex=\"-1\" style=\"background-color: rgba(0,0,0,0.5); z-index: 1055;\">\n        <div class=\"modal-dialog modal-lg\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header\">\n                    <h5 class=\"modal-title\">\n                        <i class=\"fas fa-user-plus me-2\"></i>LOTUS toevoegen aan deelopdracht\n                    </h5>\n                    <button type=\"button\" class=\"btn-close\" @onclick=\"CloseAddStaffDialog\"></button>\n                </div>\n                <div class=\"modal-body\">\n                    <!-- Shift Info -->\n                    <div class=\"alert alert-info mb-4\">\n                        <i class=\"fas fa-info-circle me-2\"></i>\n                        <strong>Personeel toevoegen aan:</strong> @shift.Name<br>\n                        <small class=\"text-muted\">\n                            <i class=\"fas fa-calendar me-1\"></i>@shift.StartTime.ToString(\"g\") - @shift.EndTime.ToString(\"g\")\n                        </small>\n                    </div>\n\n                    <!-- Search and Filter -->\n                    <div class=\"row mb-3\">\n                        <div class=\"col-md-8\">\n                            <div class=\"input-group\">\n                                <span class=\"input-group-text\">\n                                    <i class=\"fas fa-search\"></i>\n                                </span>\n                                    <input type=\"text\" class=\"form-control\" placeholder=\"Zoek personeel op naam of e-mail...\" \n                                       @bind=\"staffSearchTerm\" @oninput=\"OnStaffSearchChanged\" />\n                            </div>\n                        </div>\n                        <div class=\"col-md-4\">\n                            <select class=\"form-select\" @bind=\"staffRoleFilter\" @bind:after=\"OnStaffFilterChanged\">\n                                <option value=\"\">Alle rollen</option>\n                                <option value=\"@StaffRole.LOTUS\">LOTUS</option>\n                                <option value=\"@StaffRole.Coordinator\">Coördinator</option>\n                            </select>\n                        </div>\n                    </div>\n\n                    <!-- Available Staff List -->\n                    @if (isLoadingStaff)\n                    {\n                        <div class=\"text-center py-4\">\n                            <div class=\"spinner-border text-primary\" role=\"status\">\n                                <span class=\"visually-hidden\">Personeel laden...</span>\n                            </div>\n                        </div>\n                    }\n                    else if (!filteredAvailableStaff.Any())\n                    {\n                        <div class=\"text-center py-4\">\n                            <i class=\"fas fa-users fa-3x text-muted mb-3\"></i>\n                            <h6 class=\"text-muted\">Geen beschikbaar personeel</h6>\n                            <p class=\"text-muted\">Er komt geen personeel overeen met je zoekcriteria of is beschikbaar in dit tijdslot.</p>\n                        </div>\n                    }\n                    else\n                    {\n                        <div class=\"mb-3\">\n                            <small class=\"text-muted\">\n                                <i class=\"fas fa-info-circle me-1\"></i>\n                                Toont @filteredAvailableStaff.Count beschikbare LOTUS\n                            </small>\n                        </div>\n                        \n                        <div style=\"max-height: 400px; overflow-y: auto;\">\n                            <div class=\"list-group\">\n                                @foreach (var staffMember in filteredAvailableStaff)\n                                {\n                                    <div class=\"list-group-item list-group-item-action\">\n                                        <div class=\"d-flex justify-content-between align-items-center\">\n                                            <div class=\"flex-grow-1\">\n                                                <div class=\"d-flex align-items-center\">\n                                                    <div class=\"me-3\">\n                                                        <div class=\"bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center\" style=\"width: 40px; height: 40px;\">\n                                                            <span class=\"fw-bold\">@staffMember.FirstName.Substring(0, 1)@staffMember.LastName.Substring(0, 1)</span>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"flex-grow-1\">\n                                                        <h6 class=\"mb-1\">@staffMember.FullName</h6>\n                                                        <div class=\"d-flex align-items-center mb-1\">\n                                                            @if (!string.IsNullOrEmpty(staffMember.CertificationLevel))\n                                                            {\n                                                                <span class=\"badge bg-info me-2\">@staffMember.CertificationLevel</span>\n                                                            }\n                                                        </div>\n                                                        <small class=\"text-muted\">\n                                                            <i class=\"fas fa-envelope me-1\"></i>@staffMember.Email\n                                                            @if (!string.IsNullOrEmpty(staffMember.Phone))\n                                                            {\n                                                                <br><i class=\"fas fa-phone me-1\"></i>@staffMember.Phone\n                                                            }\n                                                        </small>\n                                                        @if (editShift.RequiredStaff > 2)\n                                                        {\n                                                            <div class=\"mt-2\">\n                                                                <label class=\"form-label small mb-1\">Rol voor deze deelopdracht:</label>\n                                                                <select class=\"form-select form-select-sm\" @bind=\"staffRoleSelections[staffMember.Id]\">\n                                                                    <option value=\"@StaffRole.LOTUS\">LOTUS</option>\n                                                                    <option value=\"@StaffRole.Coordinator\">Coördinator</option>\n                                                                </select>\n                                                            </div>\n                                                        }\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div>\n                                                <button class=\"btn btn-primary\" @onclick=\"() => AddStaffToShift(staffMember)\">\n                                                    <i class=\"fas fa-plus me-1\"></i>Toevoegen\n                                                </button>\n                                            </div>\n                                        </div>\n                                    </div>\n                                }\n                            </div>\n                        </div>\n                    }\n                </div>\n                <div class=\"modal-footer\">\n                    <button type=\"button\" class=\"btn btn-secondary\" @onclick=\"CloseAddStaffDialog\">Sluiten</button>\n                </div>\n            </div>\n        </div>\n    </div>\n}\n\n<!-- Remove Staff Confirmation Modal -->\n@if (staffToRemove is not null)\n{\n    <div class=\"modal fade show d-block\" tabindex=\"-1\" style=\"background-color: rgba(0,0,0,0.5); z-index: 1055;\">\n        <div class=\"modal-dialog\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header\">\n                    <h5 class=\"modal-title\">Verwijderen bevestigen</h5>\n                    <button type=\"button\" class=\"btn-close\" @onclick=\"CancelRemoveStaff\"></button>\n                </div>\n                <div class=\"modal-body\">\n                    <p>Weet je zeker dat je <strong>@staffToRemove.Staff.FullName</strong> van deze deelopdracht wilt verwijderen?</p>\n                    <p class=\"text-danger small\">\n                        <i class=\"fas fa-exclamation-triangle me-1\"></i>\n                        Deze actie verwijdert de LOTUS uit de deelopdracht.\n                    </p>\n                </div>\n                <div class=\"modal-footer\">\n                    <button type=\"button\" class=\"btn btn-secondary\" @onclick=\"CancelRemoveStaff\">Annuleren</button>\n                    <button type=\"button\" class=\"btn btn-danger\" @onclick=\"RemoveStaffFromShift\" disabled=\"@isRemovingStaff\">\n                        @if (isRemovingStaff)\n                        {\n                            <span class=\"spinner-border spinner-border-sm me-2\"></span>\n                        }\n                        LOTUS verwijderen\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n}\n\n@code {\n    [Parameter] public int ShiftId { get; set; }\n\n    private bool isLoading = true;\n    private bool isSaving = false;\n    private bool isLoadingStaff = false;\n    private bool isRemovingStaff = false;\n    private bool showAddStaffDialog = false;\n\n    private Entities.Shift? shift;\n    private Entities.Shift editShift = new();\n    private List<Entities.StaffAssignment> currentAssignments = new();\n    private List<Entities.Staff> availableStaff = new();\n    private List<Entities.Staff> filteredAvailableStaff = new();\n    private Entities.StaffAssignment? staffToRemove;\n    private Dictionary<int, StaffRole> staffRoleSelections = new();\n\n    private string staffSearchTerm = string.Empty;\n    private string staffRoleFilter = string.Empty;\n    private string? returnUrl;\n\n    protected override async Task OnInitializedAsync()\n    {\n        // Capture return URL from query parameter or determine from referrer\n        var uri = new Uri(Navigation.Uri);\n        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);\n        \n        if (query.TryGetValue(\"returnUrl\", out var returnUrlValue))\n        {\n            returnUrl = returnUrlValue.FirstOrDefault();\n        }\n\n        await LoadShiftDetails();\n        isLoading = false;\n    }\n\n    protected override async Task OnParametersSetAsync()\n    {\n        if (isLoading) return;\n        await LoadShiftDetails();\n    }\n\n    private async Task LoadShiftDetails()\n    {\n        var query = new GetShiftByIdQuery(ShiftId);\n        shift = await GetShiftByIdHandler.Handle(query);\n        if (shift != null)\n        {\n            // Create a copy for editing - exclude navigation properties to avoid tracking conflicts\n            editShift = new Entities.Shift\n            {\n                Id = shift.Id,\n                EventId = shift.EventId,\n                Name = shift.Name,\n                StartTime = shift.StartTime,\n                EndTime = shift.EndTime,\n                RequiredStaff = shift.RequiredStaff,\n                Description = shift.Description,\n                Status = shift.Status,\n                CreatedAt = shift.CreatedAt,\n                UpdatedAt = shift.UpdatedAt\n                // Note: Don't copy Event and StaffAssignments navigation properties\n            };\n\n            currentAssignments = shift.StaffAssignments.ToList();\n        }\n    }\n\n    private async Task LoadAvailableStaff()\n    {\n        if (shift == null) return;\n\n        isLoadingStaff = true;\n        try\n        {\n            var staffQuery = new GetActiveStaffQuery();\n            var allStaff = await GetActiveStaffHandler.Handle(staffQuery);\n            var assignedStaffIds = currentAssignments.Select(a => a.StaffId).ToHashSet();\n            \n            // Filter out already assigned staff and check availability\n            var availableStaffList = new List<Entities.Staff>();\n            \n            foreach (var staffMember in allStaff)\n            {\n                // Skip if already assigned to this shift\n                if (assignedStaffIds.Contains(staffMember.Id))\n                    continue;\n\n                // Check if staff is available during shift time\n                var availQuery = new IsStaffAvailableQuery(\n                    staffMember.Id, \n                    editShift.StartTime, \n                    editShift.EndTime\n                );\n                var isAvailable = await IsStaffAvailableHandler.Handle(availQuery);\n\n                if (isAvailable)\n                {\n                    availableStaffList.Add(staffMember);\n                    // Initialize role selection with default LOTUS role\n                    staffRoleSelections[staffMember.Id] = StaffRole.LOTUS;\n                }\n            }\n\n            availableStaff = availableStaffList;\n            ApplyStaffFilters();\n        }\n        finally\n        {\n            isLoadingStaff = false;\n            StateHasChanged();\n        }\n    }\n\n    private void ApplyStaffFilters()\n    {\n        var filtered = availableStaff.AsEnumerable();\n\n        // Apply search filter\n        if (!string.IsNullOrWhiteSpace(staffSearchTerm))\n        {\n            filtered = filtered.Where(s => \n                s.FullName.Contains(staffSearchTerm, StringComparison.OrdinalIgnoreCase) ||\n                s.Email.Contains(staffSearchTerm, StringComparison.OrdinalIgnoreCase)\n            );\n        }\n\n        // Apply role filter - disabled since Role is no longer on Staff entity\n        // Role is now per-shift in StaffAssignment\n        // if (!string.IsNullOrEmpty(staffRoleFilter) && Enum.TryParse<StaffRole>(staffRoleFilter, out var role))\n        // {\n        //     filtered = filtered.Where(s => s.Role == role);\n        // }\n\n        filteredAvailableStaff = filtered.OrderBy(s => s.LastName).ThenBy(s => s.FirstName).ToList();\n        StateHasChanged();\n    }\n\n    private void OnStaffSearchChanged(ChangeEventArgs e)\n    {\n        staffSearchTerm = e.Value?.ToString() ?? string.Empty;\n        ApplyStaffFilters();\n    }\n\n    private void OnStaffFilterChanged()\n    {\n        ApplyStaffFilters();\n    }\n\n    private async Task OpenAddStaffDialog()\n    {\n        if (currentAssignments.Count >= editShift.RequiredStaff)\n        {\n            // In a real app, show a toast notification\n            return;\n        }\n\n        staffSearchTerm = string.Empty;\n        staffRoleFilter = string.Empty;\n        showAddStaffDialog = true;\n        await LoadAvailableStaff();\n        StateHasChanged();\n    }\n\n    private void CloseAddStaffDialog()\n    {\n        showAddStaffDialog = false;\n        availableStaff.Clear();\n        filteredAvailableStaff.Clear();\n        staffRoleSelections.Clear();\n        StateHasChanged();\n    }\n\n    private async Task AddStaffToShift(Entities.Staff staffMember)\n    {\n        try\n        {\n            // Get the selected role (or default to LOTUS if not in dictionary)\n            var selectedRole = staffRoleSelections.TryGetValue(staffMember.Id, out var role) \n                ? role \n                : StaffRole.LOTUS;\n\n            var assignment = new Entities.StaffAssignment\n            {\n                ShiftId = ShiftId,\n                StaffId = staffMember.Id,\n                Role = selectedRole,\n                Status = AssignmentStatus.Assigned\n            };\n\n            var command = new CreateStaffAssignmentCommand(assignment);\n            var createdAssignment = await CreateAssignmentHandler.Handle(command);\n            \n            // Add to current assignments with staff info\n            createdAssignment.Staff = staffMember;\n            currentAssignments.Add(createdAssignment);\n            \n            // Remove from available staff and role selection\n            availableStaff.Remove(staffMember);\n            staffRoleSelections.Remove(staffMember.Id);\n            ApplyStaffFilters();\n            \n            // Close dialog if shift is now full\n            if (currentAssignments.Count >= editShift.RequiredStaff)\n            {\n                CloseAddStaffDialog();\n            }\n\n            StateHasChanged();\n        }\n        catch (Exception ex)\n        {\n            Console.WriteLine($\"Error adding staff to shift: {ex.Message}\");\n        }\n    }\n\n    private void ConfirmRemoveStaff(StaffAssignment assignment)\n    {\n        staffToRemove = assignment;\n        StateHasChanged();\n    }\n\n    private void CancelRemoveStaff()\n    {\n        staffToRemove = null;\n        StateHasChanged();\n    }\n\n    private async Task RemoveStaffFromShift()\n    {\n        if (staffToRemove == null) return;\n\n        isRemovingStaff = true;\n        try\n        {\n            var deleteCommand = new DeleteStaffAssignmentCommand(staffToRemove.Id);\n            await DeleteAssignmentHandler.Handle(deleteCommand);\n            currentAssignments.Remove(staffToRemove);\n            \n            // If add staff dialog is open, refresh available staff\n            if (showAddStaffDialog)\n            {\n                await LoadAvailableStaff();\n            }\n            \n            staffToRemove = null;\n        }\n        catch (Exception ex)\n        {\n            Console.WriteLine($\"Error removing staff from shift: {ex.Message}\");\n        }\n        finally\n        {\n            isRemovingStaff = false;\n            StateHasChanged();\n        }\n    }\n\n    private async Task SaveShift()\n    {\n        if (shift == null) return;\n\n        isSaving = true;\n        try\n        {\n            // Validate that shift times are within event duration\n            if (editShift.StartTime < shift.Event.StartDate || editShift.EndTime > shift.Event.EndDate)\n            {\n                Console.WriteLine(\"Opdrachttijden moeten binnen de duur van de overkoepelende opdracht vallen\");\n                return;\n            }\n\n            if (editShift.StartTime >= editShift.EndTime)\n            {\n                Console.WriteLine(\"Eindtijd moet na de starttijd liggen\");\n                return;\n            }\n\n            // If required staff is reduced below current assignments, we need to handle this\n            if (editShift.RequiredStaff < currentAssignments.Count)\n            {\n                Console.WriteLine($\"Aantal benodigde LOTUS kan niet lager zijn dan huidige toewijzingen ({currentAssignments.Count})\");\n                return;\n            }\n\n            var updateCommand = new UpdateShiftCommand(editShift);\n            await UpdateShiftHandler.Handle(updateCommand);\n            \n            // Navigate back to the calling page\n            NavigateBack();\n        }\n        catch (Exception ex)\n        {\n            Console.WriteLine($\"Fout bij het opslaan van de deelopdracht: {ex.Message}\");\n        }\n        finally\n        {\n            isSaving = false;\n            StateHasChanged();\n        }\n    }\n\n    private void Cancel()\n    {\n        NavigateBack();\n    }\n\n    private void NavigateBack()\n    {\n        if (!string.IsNullOrEmpty(returnUrl))\n        {\n            // Navigate to the specified return URL\n            Navigation.NavigateTo(returnUrl);\n        }\n        else if (shift != null)\n        {\n            // Default fallback: navigate to event details\n            Navigation.NavigateTo($\"/events/details/{shift.EventId}\");\n        }\n        else\n        {\n            // Ultimate fallback: navigate to events list\n            Navigation.NavigateTo(\"/events\");\n        }\n    }\n\n    private string GetRoleColor(StaffRole role)\n    {\n        return role switch\n        {\n            StaffRole.LOTUS => \"primary\",\n            StaffRole.Coordinator => \"warning\",\n            _ => \"secondary\"\n        };\n    }\n\n    private string GetAssignmentStatusColor(AssignmentStatus status)\n    {\n        return status switch\n        {\n            AssignmentStatus.Assigned => \"primary\",\n            AssignmentStatus.Confirmed => \"info\",\n            AssignmentStatus.CheckedIn => \"success\",\n            AssignmentStatus.CheckedOut => \"secondary\",\n            AssignmentStatus.NoShow => \"danger\",\n            AssignmentStatus.Cancelled => \"dark\",\n            _ => \"secondary\"\n        };\n    }\n}}
